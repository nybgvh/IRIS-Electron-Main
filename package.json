{
  "name": "iris-iucn",
  "version": "1.0.0",
  "description": "IRIS — Integrated Red List Inference from Specimens",
  "main": "main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "smoke:vv": "electron vouchervision-emulator/smoke.js"
  },
  "build": {
    "appId": "org.nybg.iris",
    "productName": "IRIS",
    "copyright": "Copyright © 2026 New York Botanical Garden",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "database.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IRIS"
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "sql.js": "^1.12.0"
  }
}
